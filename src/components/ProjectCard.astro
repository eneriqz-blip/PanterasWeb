---
import CoverArt from '@/components/CoverArt.astro';
import type { Project } from '@/data/projects';
import { getTeam } from '@/data/teams';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const team = getTeam(project.team)!;
---

<a
  class="project-card"
  href={`/proyectos/${project.slug}`}
  data-tone={team.color}
  data-team={project.team}
  data-glow
>
  <div class="cover" style={`view-transition-name: cover-${project.slug}`}>
    <CoverArt team={project.team} seed={project.slug} />
    <span class="status" data-status={project.status}>{project.status}</span>
  </div>
  <div class="content">
    <div class="meta">
      <span class="team">{team.shortName}</span>
      <span class="year">{project.year}</span>
    </div>
    <h3>{project.title}</h3>
    <p>{project.summary}</p>
    <ul class="tags">
      {project.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <div class="footer">
      <span class="metric"><strong>{project.metric.value}</strong> {project.metric.label}</span>
      <span class="go" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
          <path d="M4 10h12M12 5l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </div>
  </div>
</a>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: 1.1rem;
    background: var(--color-up-paper);
    border: 1px solid color-mix(in srgb, var(--color-up-ink) 10%, transparent);
    overflow: hidden;
    color: var(--color-up-ink);
    text-decoration: none;
    transition: transform var(--duration-base) var(--ease-editorial),
      box-shadow var(--duration-base) var(--ease-editorial),
      border-color var(--duration-base) ease;
  }
  .project-card::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      260px circle at var(--mx, 50%) var(--my, 50%),
      color-mix(in srgb, var(--color-up-gold) 22%, transparent),
      transparent 65%
    );
    opacity: 0;
    transition: opacity var(--duration-base) ease;
  }
  .project-card:hover,
  .project-card:focus-visible {
    transform: translateY(-5px);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    box-shadow: 0 28px 50px -30px rgb(0 0 0 / 0.35);
  }
  .project-card:hover::after {
    opacity: 1;
  }

  .cover {
    position: relative;
    aspect-ratio: 400 / 250;
    overflow: hidden;
  }
  .cover :global(.cover-art) {
    transition: transform 900ms var(--ease-editorial);
  }
  .project-card:hover .cover :global(.cover-art) {
    transform: scale(1.06);
  }
  .status {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-up-paper) 92%, transparent);
    color: var(--color-up-ink);
  }

  .content {
    padding: 1.35rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }
  .meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
  }
  .team {
    font-family: var(--font-body);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-text);
  }
  .year {
    color: color-mix(in srgb, var(--color-up-ink) 55%, transparent);
  }
  h3 {
    font-size: 1.2rem;
    font-family: var(--font-display);
  }
  .content p {
    font-size: 0.9rem;
    color: color-mix(in srgb, var(--color-up-ink) 70%, transparent);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
  }
  .tags li {
    font-size: 0.72rem;
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-up-ink) 16%, transparent);
    color: color-mix(in srgb, var(--color-up-ink) 65%, transparent);
  }
  .footer {
    margin-top: auto;
    padding-top: 0.9rem;
    border-top: 1px solid color-mix(in srgb, var(--color-up-ink) 10%, transparent);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.82rem;
    color: color-mix(in srgb, var(--color-up-ink) 60%, transparent);
  }
  .metric strong {
    color: var(--color-up-ink);
    font-family: var(--font-display);
  }
  .go {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    transition: transform var(--duration-fast) var(--ease-editorial);
  }
  .project-card:hover .go {
    transform: translateX(4px);
  }
</style>
