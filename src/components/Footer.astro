---
import NexusMark from '@/components/NexusMark.astro';
import { site, teamLinks, navItems, mailtoHref } from '@/data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-editorial grid">
    <div class="col-brand">
      <NexusMark variant="light" size="md" />
      <p>
        Nexus Labs es la plataforma de clubes estudiantiles de Ingeniería y
        Tecnología de la Universidad Panamericana: cuatro equipos, un mismo
        propósito de aprender construyendo.
      </p>
    </div>

    <nav aria-label="Equipos">
      <span class="kicker">Equipos</span>
      <ul>
        {teamLinks.map((team) => (
          <li><a href={team.href}>{team.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav aria-label="Sitio">
      <span class="kicker">Sitio</span>
      <ul>
        {navItems.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li><a href="/#unete">Únete</a></li>
      </ul>
    </nav>

    <div class="col-contact">
      <span class="kicker">Contacto</span>
      <ul>
        <li><a href={mailtoHref}>{site.contactEmail}</a></li>
        <li>Campus Ciudad de México</li>
        <li>{site.institution}</li>
      </ul>
    </div>
  </div>

  <div class="container-editorial legal">
    <p>© {year} {site.name} · {site.institution}. Todos los derechos reservados.</p>
    <a class="top" href="#contenido">Volver arriba ↑</a>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-up-ink);
    color: color-mix(in srgb, var(--color-up-paper) 82%, transparent);
    padding-block: clamp(3rem, 3vw, 5rem) 2rem;
    margin-top: var(--spacing-section-y);
  }

  .grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-up-paper) 14%, transparent);
  }

  .col-brand p {
    margin-top: 1.1rem;
    max-width: 30ch;
    font-size: 0.92rem;
    color: color-mix(in srgb, var(--color-up-paper) 65%, transparent);
  }

  .kicker {
    color: var(--color-up-gold);
  }

  nav ul,
  .col-contact ul {
    list-style: none;
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  nav a,
  .col-contact a {
    display: inline-block;
    padding-block: 0.2rem;
    color: inherit;
    text-decoration: none;
    font-size: 0.92rem;
    transition: color var(--duration-fast) ease, transform var(--duration-fast) var(--ease-editorial);
  }
  nav a:hover,
  .col-contact a:hover {
    color: var(--color-up-gold);
    transform: translateX(3px);
  }
  .col-contact li {
    font-size: 0.92rem;
    color: color-mix(in srgb, var(--color-up-paper) 65%, transparent);
  }

  .legal {
    padding-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--color-up-paper) 50%, transparent);
  }
  .top {
    color: var(--color-up-paper);
    text-decoration: none;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-up-paper) 25%, transparent);
    transition: background var(--duration-fast) ease, color var(--duration-fast) ease;
  }
  .top:hover {
    background: var(--color-up-paper);
    color: var(--color-up-ink);
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .col-brand {
      grid-column: 1 / -1;
    }
  }
</style>
