---
import CoverArt from '@/components/CoverArt.astro';
import type { Team } from '@/data/teams';

interface Props {
  team: Team;
  index: number;
}
const { team, index } = Astro.props;
---

<a href={`/equipos/${team.slug}`} class="team-card" data-tone={team.color} data-glow>
  <div class="cover">
    <CoverArt team={team.id} seed={`card-${team.id}`} />
    <span class="index">{String(index).padStart(2, '0')}</span>
  </div>
  <div class="content">
    <h3>{team.shortName}</h3>
    <p class="tagline">{team.tagline}</p>
    <p class="summary">{team.summary}</p>
    <div class="footer">
      <span class="stat">{team.stats[0].value} {team.stats[0].label}</span>
      <span class="arrow" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M4 10h12M12 5l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </div>
  </div>
</a>

<style>
  .team-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: 1.25rem;
    background: var(--color-up-paper);
    border: 1px solid color-mix(in srgb, var(--color-up-ink) 10%, transparent);
    text-decoration: none;
    color: var(--color-up-ink);
    overflow: hidden;
    transition: transform var(--duration-base) var(--ease-editorial),
      box-shadow var(--duration-base) var(--ease-editorial);
  }
  .team-card::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      280px circle at var(--mx, 50%) var(--my, 50%),
      color-mix(in srgb, var(--color-up-gold) 20%, transparent),
      transparent 65%
    );
    opacity: 0;
    transition: opacity var(--duration-base) ease;
  }
  .team-card:hover,
  .team-card:focus-visible {
    transform: translateY(-6px);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.32);
  }
  .team-card:hover::after {
    opacity: 1;
  }

  .cover {
    position: relative;
    aspect-ratio: 400 / 190;
    overflow: hidden;
  }
  .cover :global(.cover-art) {
    transition: transform 900ms var(--ease-editorial);
  }
  .team-card:hover .cover :global(.cover-art) {
    transform: scale(1.06);
  }
  .index {
    position: absolute;
    top: 0.8rem;
    left: 0.9rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--on-accent);
  }

  .content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.6rem 1.75rem 1.75rem;
  }
  h3 {
    font-size: var(--text-display-md);
  }
  .tagline {
    margin-top: 0.5rem;
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--accent-text);
  }
  .summary {
    margin-top: 0.8rem;
    font-size: 0.95rem;
    color: color-mix(in srgb, var(--color-up-ink) 72%, transparent);
    max-width: 44ch;
  }

  .footer {
    margin-top: auto;
    padding-top: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid color-mix(in srgb, var(--color-up-ink) 12%, transparent);
  }
  .content .summary + .footer {
    margin-top: 1.5rem;
  }
  .stat {
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--color-up-ink) 60%, transparent);
  }
  .arrow {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    transition: transform var(--duration-fast) var(--ease-editorial);
  }
  .team-card:hover .arrow {
    transform: translateX(4px) scale(1.05);
  }
</style>
