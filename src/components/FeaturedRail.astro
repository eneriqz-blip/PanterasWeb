---
import ProjectCard from '@/components/ProjectCard.astro';
import type { Project } from '@/data/projects';

interface Props {
  projects: Project[];
  label: string;
}
const { projects, label } = Astro.props;
---

<div class="rail" data-rail>
  <div class="controls">
    <button type="button" data-rail-prev aria-label="Anterior" disabled>
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M16 10H4M8 5l-5 5 5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <button type="button" data-rail-next aria-label="Siguiente">
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M4 10h12M12 5l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
  </div>
  <div class="track" data-rail-track role="region" aria-label={label} tabindex="0">
    {projects.map((project) => (
      <div class="item">
        <ProjectCard project={project} />
      </div>
    ))}
  </div>
</div>

<style>
  .rail {
    position: relative;
  }
  .controls {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .controls button {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-up-ink) 22%, transparent);
    background: var(--color-up-paper);
    color: var(--color-up-ink);
    cursor: pointer;
    transition: background var(--duration-fast) ease, color var(--duration-fast) ease,
      transform var(--duration-fast) var(--ease-editorial), opacity var(--duration-fast) ease;
  }
  .controls button:hover:not(:disabled) {
    background: var(--color-up-ink);
    color: var(--color-up-paper);
    transform: scale(1.06);
  }
  .controls button:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .track {
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: clamp(1.25rem, 3vw, 4rem);
    padding: 0.5rem clamp(1.25rem, 3vw, 4rem) 1.5rem;
    margin-inline: calc(clamp(1.25rem, 3vw, 4rem) * -1);
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--color-up-ink) 30%, transparent) transparent;
    overscroll-behavior-x: contain;
  }
  .item {
    flex: 0 0 min(84vw, 25rem);
    scroll-snap-align: start;
  }

  @media (max-width: 640px) {
    .controls {
      display: none;
    }
  }
</style>
