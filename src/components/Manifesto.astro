---
interface Props {
  text: string;
  kicker?: string;
}

const { text, kicker } = Astro.props;
const words = text.split(/\s+/).filter(Boolean);
---

<div class="manifesto">
  {kicker && <p class="kicker">{kicker}</p>}
  <p class="statement" aria-label={text}>
    {words.map((word) => <span class="w" aria-hidden="true">{word} </span>)}
  </p>
</div>

<style>
  .manifesto {
    max-width: 62rem;
  }
  .statement {
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.7rem, 1.05rem + 2.7vw, 3.4rem);
    line-height: 1.16;
    letter-spacing: -0.01em;
    color: var(--color-up-ink);
  }

  @supports (animation-timeline: view()) {
    .w {
      opacity: 0.16;
      animation: word-in linear both;
      animation-timeline: view();
      animation-range: entry 18% cover 34%;
    }
    @keyframes word-in {
      to { opacity: 1; }
    }
  }
</style>
