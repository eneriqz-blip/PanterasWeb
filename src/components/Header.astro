---
import NexusMark from '@/components/NexusMark.astro';
import { teams } from '@/data/teams';

const nav = [
  { href: '/', label: 'Inicio' },
  { href: '/equipos', label: 'Equipos' },
  { href: '/proyectos', label: 'Proyectos' },
];

const currentPath = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header" data-header>
  <div class="container-editorial bar">
    <a href="/" class="brand" aria-label="Nexus Labs — Inicio">
      <NexusMark size="sm" />
    </a>

    <nav class="nav" aria-label="Navegación principal">
      <ul>
        {nav.map((item) => (
          <li class:list={['nav__item', { 'has-menu': item.label === 'Equipos' }]}>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
            {item.label === 'Equipos' && (
              <div class="mega">
                <ul>
                  {teams.map((team) => (
                    <li>
                      <a href={`/equipos/${team.slug}`}>
                        <span class:list={['dot', `dot--${team.color}`]} aria-hidden="true"></span>
                        {team.shortName}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <a class="cta" href="/#unete">Únete</a>

    <button class="burger" type="button" aria-label="Abrir menú" aria-expanded="false" data-menu-toggle>
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-panel" data-mobile-panel>
    <ul>
      {nav.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
      <li class="mobile-panel__group">
        <span class="kicker">Equipos</span>
        <ul>
          {teams.map((team) => (
            <li><a href={`/equipos/${team.slug}`}>{team.shortName}</a></li>
          ))}
        </ul>
      </li>
      <li><a class="cta cta--block" href="/#unete">Únete a Nexus Labs</a></li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-mobile-panel]');
  toggle?.addEventListener('click', () => {
    const open = panel?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(Boolean(open)));
  });

  const header = document.querySelector<HTMLElement>('[data-header]');
  document.addEventListener(
    'scroll',
    () => {
      header?.classList.toggle('is-scrolled', window.scrollY > 8);
    },
    { passive: true }
  );
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-up-paper) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-base) var(--ease-editorial);
  }
  .site-header.is-scrolled {
    border-bottom-color: color-mix(in srgb, var(--color-up-ink) 10%, transparent);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.1rem;
  }

  .brand {
    margin-right: auto;
    color: inherit;
  }

  .nav ul {
    display: flex;
    gap: 2rem;
    list-style: none;
  }
  .nav a {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-up-ink);
    text-decoration: none;
    padding-block: 0.4rem;
    position: relative;
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -2px;
    height: 2px;
    background: var(--color-up-garnet);
    transition: right var(--duration-base) var(--ease-editorial);
  }
  .nav a:hover::after,
  .nav a[aria-current='page']::after {
    right: 0;
  }

  .nav__item.has-menu {
    position: relative;
  }
  .mega {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translate(-50%, 6px);
    background: var(--color-up-paper);
    border: 1px solid color-mix(in srgb, var(--color-up-ink) 10%, transparent);
    border-radius: 0.75rem;
    box-shadow: 0 20px 40px -20px rgb(0 0 0 / 0.25);
    padding: 0.6rem;
    min-width: 13rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--duration-fast) ease, transform var(--duration-fast) ease;
  }
  .nav__item.has-menu:hover .mega,
  .nav__item.has-menu:focus-within .mega {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }
  .mega ul {
    flex-direction: column;
    gap: 0.1rem;
  }
  .mega a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    white-space: nowrap;
  }
  .mega a:hover {
    background: color-mix(in srgb, var(--color-up-gold) 18%, transparent);
  }
  .mega a::after { display: none; }

  .dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    flex: none;
  }
  .dot--blue { background: var(--color-up-blue); }
  .dot--garnet { background: var(--color-up-garnet); }
  .dot--green { background: var(--color-up-green); }
  .dot--gold { background: var(--color-up-gold); }

  .cta {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-up-paper);
    background: var(--color-up-ink);
    padding: 0.6rem 1.15rem;
    border-radius: 999px;
    text-decoration: none;
    transition: background var(--duration-fast) ease, transform var(--duration-fast) ease;
  }
  .cta:hover {
    background: var(--color-up-garnet);
    transform: translateY(-1px);
  }

  .burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 0;
    padding: 0.4rem;
    cursor: pointer;
  }
  .burger span {
    width: 22px;
    height: 2px;
    background: var(--color-up-ink);
    display: block;
  }

  .mobile-panel {
    display: none;
  }

  @media (max-width: 860px) {
    .nav, .cta { display: none; }
    .burger { display: flex; }

    .mobile-panel {
      display: block;
      max-height: 0;
      overflow: hidden;
      background: var(--color-up-paper);
      border-bottom: 1px solid color-mix(in srgb, var(--color-up-ink) 10%, transparent);
      transition: max-height var(--duration-base) var(--ease-editorial);
    }
    .mobile-panel.is-open {
      max-height: 32rem;
    }
    .mobile-panel > ul {
      list-style: none;
      padding: 1rem clamp(1.25rem, 3vw, 4rem) 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
    }
    .mobile-panel a {
      font-family: var(--font-body);
      font-size: 1.05rem;
      color: var(--color-up-ink);
      text-decoration: none;
    }
    .mobile-panel__group ul {
      list-style: none;
      margin-top: 0.6rem;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      padding-left: 0.75rem;
    }
    .cta--block {
      margin-top: 0.5rem;
      justify-content: center;
      width: 100%;
    }
  }
</style>
