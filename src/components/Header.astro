---
import NexusMark from '@/components/NexusMark.astro';
import { site, navItems, teamLinks } from '@/data/site';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="site-header" data-header>
  <div class="progress" aria-hidden="true"></div>
  <div class="container-editorial bar">
    <a href="/" class="brand" aria-label="Nexus Labs — Inicio">
      <NexusMark size="sm" />
    </a>

    <nav class="nav" aria-label="Navegación principal">
      <ul>
        {navItems.map((item) => (
          <li class:list={['nav__item', { 'has-menu': item.label === 'Equipos' }]}>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
            {item.label === 'Equipos' && (
              <div class="mega">
                <ul>
                  {teamLinks.map((team) => (
                    <li>
                      <a href={team.href}>
                        <span class:list={['dot', `dot--${team.color}`]} aria-hidden="true"></span>
                        {team.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <a class="cta" href="/#unete">Únete</a>

    <button
      class="burger"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="site-menu"
      data-menu-toggle
    >
      <span></span><span></span>
    </button>
  </div>
</header>

<div class="menu" id="site-menu" inert>
  <div class="container-editorial menu__inner">
    <nav aria-label="Menú principal">
      <ol class="menu__primary">
        {navItems.map((item, i) => (
          <li style={`--i:${i}`}>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              <span class="n">{String(i + 1).padStart(2, '0')}</span>
              {item.label}
            </a>
          </li>
        ))}
      </ol>

      <div class="menu__teams" style={`--i:${navItems.length}`}>
        <p class="kicker">Equipos</p>
        <ul>
          {teamLinks.map((team) => (
            <li>
              <a href={team.href}>
                <span class:list={['dot', `dot--${team.color}`]} aria-hidden="true"></span>
                {team.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>

    <div class="menu__foot" style={`--i:${navItems.length + 1}`}>
      <a class="menu__cta" href="/#unete">Únete a Nexus Labs</a>
      <p>{site.institution}</p>
    </div>
  </div>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    view-transition-name: site-header;
    background: color-mix(in srgb, var(--color-up-paper) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: transform var(--duration-base) var(--ease-editorial),
      border-color var(--duration-base) var(--ease-editorial);
  }
  .site-header.is-scrolled {
    border-bottom-color: color-mix(in srgb, var(--color-up-ink) 10%, transparent);
  }
  .site-header.is-hidden {
    transform: translateY(-100%);
  }

  .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: linear-gradient(90deg, var(--color-up-gold), var(--color-up-garnet));
    transform: scaleX(0);
    transform-origin: left;
    pointer-events: none;
  }
  @supports (animation-timeline: scroll()) {
    .progress {
      animation: grow linear both;
      animation-timeline: scroll(root);
    }
    @keyframes grow {
      to { transform: scaleX(1); }
    }
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: 0.95rem;
  }
  .brand {
    margin-right: auto;
    color: inherit;
  }

  .nav ul {
    display: flex;
    gap: 2rem;
    list-style: none;
  }
  .nav a {
    position: relative;
    display: inline-block;
    padding-block: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-up-ink);
    text-decoration: none;
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0;
    height: 2px;
    background: var(--color-up-garnet);
    transition: right var(--duration-base) var(--ease-editorial);
  }
  .nav a:hover::after,
  .nav a[aria-current='page']::after {
    right: 0;
  }

  .nav__item.has-menu {
    position: relative;
  }
  .mega {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translate(-50%, 6px);
    background: var(--color-up-paper);
    border: 1px solid color-mix(in srgb, var(--color-up-ink) 10%, transparent);
    border-radius: 0.75rem;
    box-shadow: 0 20px 40px -20px rgb(0 0 0 / 0.25);
    padding: 0.6rem;
    min-width: 13rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--duration-fast) ease, transform var(--duration-fast) ease;
  }
  .nav__item.has-menu:hover .mega,
  .nav__item.has-menu:focus-within .mega {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }
  .mega ul {
    flex-direction: column;
    gap: 0.1rem;
  }
  .mega a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.75rem;
    border-radius: 0.5rem;
    white-space: nowrap;
  }
  .mega a:hover {
    background: color-mix(in srgb, var(--color-up-gold) 18%, transparent);
  }
  .mega a::after {
    display: none;
  }

  .dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
    flex: none;
  }
  .dot--blue { background: var(--color-up-blue); }
  .dot--garnet { background: var(--color-up-garnet); }
  .dot--green { background: var(--color-up-green); }
  .dot--gold { background: var(--color-up-gold); }

  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-up-paper);
    background: var(--color-up-ink);
    padding: 0.6rem 1.2rem;
    border-radius: 999px;
    text-decoration: none;
    transition: background var(--duration-fast) ease, transform var(--duration-fast) var(--ease-editorial);
  }
  .cta:hover {
    background: var(--color-up-garnet);
    transform: translateY(-1px);
  }

  .burger {
    display: none;
    position: relative;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.5rem;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .burger span {
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    height: 2px;
    background: var(--color-up-ink);
    transition: transform var(--duration-base) var(--ease-editorial);
  }
  .burger span:first-child { top: calc(50% - 4px); }
  .burger span:last-child { top: calc(50% + 3px); }
  :global(html.menu-open) .burger span:first-child { transform: translateY(3.5px) rotate(45deg); }
  :global(html.menu-open) .burger span:last-child { transform: translateY(-3.5px) rotate(-45deg); }

  .menu {
    display: none;
  }

  @media (max-width: 860px) {
    .nav,
    .cta {
      display: none;
    }
    .burger {
      display: block;
    }

    .menu {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 55;
      overflow-y: auto;
      background: var(--color-up-paper);
      clip-path: circle(0% at calc(100% - 1.9rem) 2.2rem);
      visibility: hidden;
      transition: clip-path 650ms var(--ease-editorial), visibility 0s linear 650ms;
    }
    :global(html.menu-open) .menu {
      clip-path: circle(150% at calc(100% - 1.9rem) 2.2rem);
      visibility: visible;
      transition: clip-path 650ms var(--ease-editorial), visibility 0s;
    }
    :global(html.menu-open) {
      overflow: hidden;
    }

    .menu__inner {
      min-height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 2rem;
      padding-block: 6rem 2rem;
    }
    .menu__primary {
      list-style: none;
    }
    .menu__primary a {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      padding-block: 0.35rem;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: clamp(2.4rem, 11vw, 3.6rem);
      line-height: 1.05;
      text-transform: uppercase;
      color: var(--color-up-ink);
      text-decoration: none;
    }
    .menu__primary a[aria-current='page'] {
      color: var(--color-up-garnet);
    }
    .menu__primary .n {
      font-family: var(--font-body);
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      color: var(--color-up-gold-ink);
    }

    .menu__teams {
      margin-top: 2rem;
    }
    .menu__teams ul {
      margin-top: 0.75rem;
      list-style: none;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.25rem 1rem;
    }
    .menu__teams a {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      min-height: 2.75rem;
      font-family: var(--font-body);
      font-size: 1.05rem;
      font-weight: 500;
      color: var(--color-up-ink);
      text-decoration: none;
    }

    .menu__foot {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      font-size: 0.85rem;
      color: color-mix(in srgb, var(--color-up-ink) 60%, transparent);
    }
    .menu__cta {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 3.25rem;
      border-radius: 999px;
      background: var(--color-up-ink);
      color: var(--color-up-paper);
      font-family: var(--font-body);
      font-weight: 600;
      text-decoration: none;
    }

    .menu__primary li,
    .menu__teams,
    .menu__foot {
      opacity: 0;
      transform: translateY(22px);
      transition: opacity 500ms ease, transform 600ms var(--ease-editorial);
    }
    :global(html.menu-open) .menu__primary li,
    :global(html.menu-open) .menu__teams,
    :global(html.menu-open) .menu__foot {
      opacity: 1;
      transform: none;
      transition-delay: calc(180ms + var(--i, 0) * 70ms);
    }
  }
</style>
