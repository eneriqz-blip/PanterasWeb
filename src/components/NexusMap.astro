---
import { teams } from '@/data/teams';

const positions = [
  { x: 118, y: 112 },
  { x: 446, y: 96 },
  { x: 104, y: 336 },
  { x: 452, y: 344 },
];
const short: Record<string, string> = {
  'computer-science': 'CS',
  play: 'PL',
  mechanics: 'ME',
  iise: 'II',
};
const center = { x: 280, y: 222 };

const order = ['computer-science', 'play', 'iise', 'mechanics'];
const ring = order.map((slug, i) => {
  const a = positions[teams.findIndex((t) => t.slug === slug)];
  const b = positions[teams.findIndex((t) => t.slug === order[(i + 1) % order.length])];
  const mx = (a.x + b.x) / 2 + (a.y === b.y ? 0 : (a.x < center.x ? -34 : 34));
  const my = (a.y + b.y) / 2 + (a.x === b.x ? 0 : (a.y < center.y ? -34 : 34));
  return `M${a.x} ${a.y}Q${mx} ${my} ${b.x} ${b.y}`;
});
---

<svg class="nexus-map" viewBox="0 0 560 440" role="group" aria-label="Los cuatro equipos de Nexus Labs">
  <g class="ring-lines" aria-hidden="true">
    {ring.map((d) => <path d={d} />)}
  </g>
  <g class="spokes" aria-hidden="true">
    {teams.map((team, i) => (
      <line x1={center.x} y1={center.y} x2={positions[i].x} y2={positions[i].y} data-tone={team.color} />
    ))}
  </g>

  <g class="core" aria-hidden="true">
    <circle cx={center.x} cy={center.y} r="58" class="pulse" />
    <circle cx={center.x} cy={center.y} r="44" class="disc" />
    <text x={center.x} y={center.y + 13} text-anchor="middle" class="core-letter">N</text>
  </g>

  {teams.map((team, i) => (
    <a
      href={`/equipos/${team.slug}`}
      class="node"
      data-tone={team.color}
      style={`--i:${i}`}
      aria-label={`${team.shortName}: ${team.tagline}`}
    >
      <g class="float">
        <g class="body" style={`transform-origin:${positions[i].x}px ${positions[i].y}px`}>
          <circle cx={positions[i].x} cy={positions[i].y} r="46" class="halo" />
          <circle cx={positions[i].x} cy={positions[i].y} r="38" class="outer" />
          <circle cx={positions[i].x} cy={positions[i].y} r="29" class="inner" />
          <text x={positions[i].x} y={positions[i].y + 7} text-anchor="middle" class="code">
            {short[team.slug]}
          </text>
          <text x={positions[i].x} y={positions[i].y + 68} text-anchor="middle" class="label">
            {team.shortName}
          </text>
        </g>
      </g>
    </a>
  ))}
</svg>

<style>
  .nexus-map {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .ring-lines path {
    fill: none;
    stroke: color-mix(in srgb, var(--color-up-paper) 34%, transparent);
    stroke-width: 1;
    stroke-dasharray: 3 9;
    animation: dash 5s linear infinite;
  }
  .spokes line {
    stroke: color-mix(in srgb, var(--color-up-paper) 42%, transparent);
    stroke-width: 1.2;
    stroke-dasharray: 5 7;
    animation: dash 3.2s linear infinite;
  }

  .core .disc {
    fill: var(--color-up-gold);
  }
  .core .pulse {
    fill: none;
    stroke: var(--color-up-gold);
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
    animation: pulse 3.4s var(--ease-editorial) infinite;
  }
  .core-letter {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 46px;
    fill: var(--color-up-ink);
  }

  .node {
    cursor: pointer;
    outline: none;
  }
  .float {
    transform-box: fill-box;
    transform-origin: center;
    animation: float 6.5s ease-in-out infinite;
    animation-delay: calc(var(--i) * -1.7s);
  }
  .body {
    transform-box: view-box;
    transition: transform var(--duration-base) var(--ease-editorial);
  }
  .node:hover .body,
  .node:focus-visible .body {
    transform: scale(1.14);
  }
  .halo {
    fill: none;
    stroke: var(--color-up-paper);
    stroke-width: 1;
    opacity: 0;
    transition: opacity var(--duration-base) ease;
  }
  .node:hover .halo,
  .node:focus-visible .halo {
    opacity: 0.7;
  }
  .outer {
    fill: var(--color-up-paper);
  }
  .inner {
    fill: var(--accent);
  }
  .code {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 19px;
    fill: var(--on-accent);
  }
  .label {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.04em;
    fill: var(--color-up-paper);
  }

  @keyframes dash {
    to { stroke-dashoffset: -48; }
  }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-7px); }
  }
  @keyframes pulse {
    0% { transform: scale(0.85); opacity: 0.9; }
    100% { transform: scale(1.6); opacity: 0; }
  }
</style>
