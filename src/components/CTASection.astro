---
import Button from '@/components/Button.astro';
import { site, mailtoHref } from '@/data/site';
---

<section id="unete" class="cta-section franco-cuartel">
  <div class="tahali" aria-hidden="true"></div>
  <div class="container-editorial inner">
    <p class="kicker">Únete a Nexus Labs</p>
    <h2>
      Elige un equipo.<br />Empieza a construir esta semana.
    </h2>
    <p class="lead">
      No necesitas experiencia previa, sólo disposición para aprender en
      equipo. Escríbenos y te conectamos con el equipo que mejor se ajuste a
      lo que quieres construir.
    </p>
    <div class="actions">
      <Button href={mailtoHref} variant="secondary">Escríbenos por correo</Button>
      <button type="button" class="copy" data-copy={site.contactEmail}>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.4" />
          <path d="M10.5 5.5V4A1.5 1.5 0 0 0 9 2.5H4A1.5 1.5 0 0 0 2.5 4v5A1.5 1.5 0 0 0 4 10.5h1.5" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <span data-copy-label>Copiar correo</span>
      </button>
      <Button href="/equipos" variant="ghost">Comparar los 4 equipos</Button>
    </div>
    <p class="address">{site.contactEmail}</p>
  </div>
</section>

<style>
  .cta-section {
    position: relative;
    background: var(--color-up-ink);
    color: var(--color-up-paper);
    padding-block: var(--spacing-section-y);
    border-radius: 1.5rem;
    margin-inline: clamp(1rem, 2vw, 2rem);
  }
  .cta-section .tahali {
    inset: 0;
    background: linear-gradient(
      106deg,
      transparent 0 62%,
      color-mix(in srgb, var(--color-up-gold) 28%, transparent) 62% 70%,
      transparent 70% 100%
    );
  }
  .inner {
    position: relative;
    z-index: 2;
    max-width: 44rem;
  }
  h2 {
    margin-top: 1rem;
    font-size: var(--text-display-lg);
  }
  .lead {
    margin-top: 1.5rem;
    color: color-mix(in srgb, var(--color-up-paper) 75%, transparent);
    max-width: 46ch;
  }
  .actions {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }
  .address {
    margin-top: 1.25rem;
    font-size: 0.85rem;
    color: color-mix(in srgb, var(--color-up-paper) 55%, transparent);
    user-select: all;
  }

  .copy {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.9rem;
    padding: 0.7rem 1.2rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-up-paper) 35%, transparent);
    background: transparent;
    color: var(--color-up-paper);
    font-family: var(--font-body);
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
    transition: background var(--duration-fast) ease, border-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }
  .copy:hover {
    border-color: var(--color-up-paper);
    background: color-mix(in srgb, var(--color-up-paper) 10%, transparent);
  }
  .copy.is-done {
    background: var(--color-up-gold);
    border-color: var(--color-up-gold);
    color: var(--color-up-ink);
  }

  .cta-section :global(.btn--ghost) {
    color: var(--color-up-paper);
    border-color: color-mix(in srgb, var(--color-up-paper) 35%, transparent);
  }
  .cta-section :global(.btn--ghost:hover) {
    border-color: var(--color-up-paper);
    background: color-mix(in srgb, var(--color-up-paper) 10%, transparent);
  }
</style>
