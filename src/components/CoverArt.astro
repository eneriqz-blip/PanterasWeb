---
import type { TeamId } from '@/data/teams';
import { ART_W, ART_H, network, sprites, gears, flows } from '@/lib/art';

interface Props {
  team: TeamId;
  seed: string;
}

const { team, seed } = Astro.props;

const net = team === 'computer-science' ? network(seed) : null;
const pix = team === 'play' ? sprites(seed) : null;
const mech = team === 'mechanics' ? gears(seed) : null;
const flow = team === 'iise' ? flows(seed) : null;
---

<svg
  class="cover-art"
  viewBox={`0 0 ${ART_W} ${ART_H}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <rect width={ART_W} height={ART_H} class="bg" />
  <polygon points="70,0 130,0 350,260 290,260" class="band" />

  {net && (
    <g class="network">
      {net.edges.map((e) => <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} />)}
      {net.nodes.map((n) =>
        n.ring ? <circle cx={n.x} cy={n.y} r={n.r + 3} class="ring" /> : null
      )}
      {net.nodes.map((n) => <circle cx={n.x} cy={n.y} r={n.r} class="dot" />)}
    </g>
  )}

  {pix && (
    <g class="sprites">
      {pix.cells.map((c) => (
        <rect x={c.x + 1} y={c.y + 1} width={pix.size - 2} height={pix.size - 2} rx="2" opacity={c.o} />
      ))}
    </g>
  )}

  {mech && (
    <g class="mechanics">
      {mech.rings.map((r) => <circle cx={r.cx} cy={r.cy} r={r.r} class="ring" />)}
      {mech.gears.map((g, i) => (
        <g class:list={['gear', `gear--${i}`]} style={`transform-origin:${g.cx}px ${g.cy}px`}>
          <path d={g.path} class="tooth" />
          <circle cx={g.cx} cy={g.cy} r={g.hub} class="hub" />
        </g>
      ))}
    </g>
  )}

  {flow && (
    <g class="flows">
      {flow.links.map((l) => <path d={l.d} stroke-width={l.w} class="link" />)}
      {flow.nodes.map((n) => <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="4" class="node" />)}
    </g>
  )}
</svg>

<style>
  .cover-art {
    display: block;
    width: 100%;
    height: 100%;
    --art: var(--on-accent, var(--color-up-paper));
  }
  .bg {
    fill: color-mix(in srgb, var(--accent, var(--color-up-blue)) 94%, black);
  }
  .band {
    fill: var(--art);
    opacity: 0.09;
  }

  .network line {
    stroke: var(--art);
    stroke-width: 1;
    opacity: 0.4;
  }
  .network .dot {
    fill: var(--art);
    opacity: 0.9;
  }
  .network .ring {
    fill: none;
    stroke: var(--art);
    stroke-width: 1;
    opacity: 0.5;
  }

  .sprites rect {
    fill: var(--art);
  }

  .mechanics .ring {
    fill: none;
    stroke: var(--art);
    stroke-width: 1;
    stroke-dasharray: 2 6;
    opacity: 0.35;
  }
  .mechanics .tooth {
    fill: var(--art);
    opacity: 0.85;
  }
  .mechanics .hub {
    fill: color-mix(in srgb, var(--accent, var(--color-up-blue)) 94%, black);
  }
  .gear {
    transform-box: view-box;
    transition: transform 1.6s var(--ease-editorial);
  }
  :global([data-glow]:hover) .gear--0,
  :global(.stack-card:hover) .gear--0 {
    transform: rotate(35deg);
  }
  :global([data-glow]:hover) .gear--1,
  :global(.stack-card:hover) .gear--1 {
    transform: rotate(-46deg);
  }
  :global([data-glow]:hover) .gear--2,
  :global(.stack-card:hover) .gear--2 {
    transform: rotate(38deg);
  }

  .flows .link {
    fill: none;
    stroke: var(--art);
    opacity: 0.28;
  }
  .flows .node {
    fill: var(--art);
    opacity: 0.9;
  }
</style>
