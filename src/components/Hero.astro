---
import Button from '@/components/Button.astro';
import NexusMap from '@/components/NexusMap.astro';
---

<section class="hero">
  <div class="container-editorial hero__grid">
    <div class="hero__copy">
      <p class="kicker rise" style="--d:0">Nexus Labs · Universidad Panamericana</p>
      <h1>
        <span class="rise" style="--d:1">Cuatro equipos.</span>
        <span class="rise" style="--d:2">Un mismo propósito:</span>
        <span class="rise accent" style="--d:3">aprender construyendo.</span>
      </h1>
      <p class="lead rise" style="--d:4">
        Nexus Labs reúne a los clubes estudiantiles de ingeniería y tecnología
        de la Universidad Panamericana —Computer Science, Play, Mechanics e
        IISE— bajo un mismo laboratorio de proyectos reales, con mentoría
        entre pares y estándares de la industria.
      </p>
      <div class="hero__actions rise" style="--d:5">
        <Button href="/equipos" variant="secondary">Conoce los equipos</Button>
        <Button href="/proyectos" variant="ghost">Ver proyectos</Button>
      </div>
    </div>

    <div class="hero__visual rise" style="--d:2">
      <div class="franco franco-cuartel">
        <div class="tahali" aria-hidden="true"></div>
        <div class="franco__map">
          <NexusMap />
        </div>
        <p class="franco__hint">Toca un equipo para explorarlo</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2.5rem, 4vw, 4.5rem) clamp(3rem, 5vw, 5rem);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 4vw, 4.5rem);
    align-items: center;
  }

  h1 {
    margin-top: 1.1rem;
    font-size: clamp(2.35rem, 1.3rem + 3.6vw, 4.6rem);
    line-height: 0.98;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--color-up-ink);
  }
  h1 span {
    display: block;
  }
  h1 .accent {
    margin-top: 0.15em;
    text-transform: none;
    letter-spacing: -0.01em;
    color: var(--color-up-garnet);
  }

  .lead {
    margin-top: 1.75rem;
    max-width: 44ch;
    font-size: clamp(1.02rem, 0.95rem + 0.3vw, 1.2rem);
    color: color-mix(in srgb, var(--color-up-ink) 78%, transparent);
  }

  .hero__actions {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .franco {
    position: relative;
    border-radius: 1.5rem;
    background:
      radial-gradient(120% 90% at 20% 0%, color-mix(in srgb, var(--color-up-blue-light) 55%, transparent), transparent 60%),
      var(--color-up-blue);
    aspect-ratio: 5 / 4;
    display: grid;
    place-items: center;
    padding: clamp(0.75rem, 2vw, 1.5rem);
    box-shadow: 0 40px 80px -40px color-mix(in srgb, var(--color-up-blue) 70%, transparent);
  }
  .franco .tahali {
    background: linear-gradient(
      108deg,
      transparent 0 30%,
      color-mix(in srgb, var(--color-up-gold) 22%, transparent) 30% 37%,
      transparent 37% 100%
    );
    inset: 0;
  }
  .franco__map {
    position: relative;
    z-index: 2;
    width: 100%;
  }
  .franco__hint {
    position: absolute;
    left: 1.25rem;
    bottom: 1rem;
    z-index: 2;
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-up-paper) 70%, transparent);
  }

  @supports (animation-timeline: scroll()) {
    .franco {
      animation: hero-drift linear both;
      animation-timeline: scroll(root);
      animation-range: 0 70vh;
    }
    @keyframes hero-drift {
      to { transform: translateY(-34px); }
    }
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .franco {
      aspect-ratio: 4 / 3.4;
    }
  }
</style>
