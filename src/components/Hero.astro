---
import Button from '@/components/Button.astro';
---

<section class="hero franco-cuartel">
  <div class="tahali"></div>
  <div class="container-editorial hero__inner">
    <p class="kicker">Nexus Labs · Universidad Panamericana</p>
    <h1>
      Cuatro equipos.<br />
      Un mismo propósito: <span class="accent">aprender construyendo.</span>
    </h1>
    <p class="lead">
      Nexus Labs reúne a los clubes estudiantiles de ingeniería y tecnología
      de la Universidad Panamericana —Computer Science, Play, Mechanics e
      IISE— bajo un mismo laboratorio de proyectos reales, con mentoría entre
      pares y estándares de la industria.
    </p>
    <div class="hero__actions">
      <Button href="/equipos" variant="secondary">Conoce los equipos</Button>
      <Button href="/proyectos" variant="ghost">Ver proyectos</Button>
    </div>
  </div>

  <div class="hero__scroll" aria-hidden="true">
    <span></span>
    <p>Desplázate</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(46rem, 92vh);
    display: flex;
    align-items: center;
    background: var(--color-up-paper);
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    padding-block: clamp(6rem, 8vw, 9rem) clamp(4rem, 6vw, 6rem);
    max-width: 54rem;
  }

  h1 {
    margin-top: 1.1rem;
    font-size: var(--text-display-xl);
    color: var(--color-up-ink);
  }

  .accent {
    color: var(--color-up-garnet);
  }

  .lead {
    margin-top: 1.75rem;
    max-width: 42ch;
    font-size: clamp(1.05rem, 0.95rem + 0.3vw, 1.25rem);
    font-weight: 300;
    color: color-mix(in srgb, var(--color-up-ink) 78%, transparent);
  }

  .hero__actions {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero__scroll {
    position: absolute;
    right: clamp(1.25rem, 3vw, 4rem);
    bottom: 2rem;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: color-mix(in srgb, var(--color-up-ink) 55%, transparent);
  }
  .hero__scroll span {
    width: 1px;
    height: 2.5rem;
    background: currentColor;
    display: block;
    animation: scrollpulse 2.2s var(--ease-editorial) infinite;
  }
  .hero__scroll p {
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
  }

  @keyframes scrollpulse {
    0%, 100% { opacity: 0.35; }
    50% { opacity: 1; }
  }

  @media (max-width: 640px) {
    .hero__scroll { display: none; }
  }
</style>
