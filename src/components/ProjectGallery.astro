---
import ProjectCard from '@/components/ProjectCard.astro';
import { teams } from '@/data/teams';
import { projects as allProjects, type Project } from '@/data/projects';

interface Props {
  projects?: Project[];
  filterable?: boolean;
}
const { projects = allProjects, filterable = true } = Astro.props;
---

<div class="gallery" data-gallery>
  {filterable && (
    <div class="toolbar">
      <div class="filters" role="group" aria-label="Filtrar proyectos por equipo">
        <button type="button" class="filter is-active" data-filter="all" aria-pressed="true">
          Todos
          <span class="count">{projects.length}</span>
        </button>
        {teams.map((team) => {
          const count = projects.filter((p) => p.team === team.id).length;
          return (
            <button
              type="button"
              class="filter"
              data-filter={team.id}
              data-tone={team.color}
              aria-pressed="false"
            >
              {team.shortName}
              <span class="count">{count}</span>
            </button>
          );
        })}
      </div>
      <p class="status" data-status role="status" aria-live="polite">
        Mostrando {projects.length} de {projects.length} proyectos
      </p>
    </div>
  )}

  <p class="empty" data-empty hidden>No hay proyectos para este filtro todavía.</p>

  <div class="grid" data-grid>
    {projects.map((project) => (
      <div class="cell" data-card data-card-team={project.team}>
        <ProjectCard project={project} />
      </div>
    ))}
  </div>
</div>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const buttons = Array.from(gallery?.querySelectorAll<HTMLButtonElement>('[data-filter]') ?? []);
  const cards = Array.from(gallery?.querySelectorAll<HTMLElement>('[data-card]') ?? []);
  const empty = gallery?.querySelector<HTMLElement>('[data-empty]');
  const status = gallery?.querySelector<HTMLElement>('[data-status]');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (gallery && buttons.length) {
    const valid = new Set(buttons.map((button) => button.dataset.filter));

    const apply = (team: string) => {
      let visible = 0;
      for (const card of cards) {
        const match = team === 'all' || card.dataset.cardTeam === team;
        card.hidden = !match;
        if (match) visible += 1;
      }
      for (const button of buttons) {
        const active = button.dataset.filter === team;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      }
      if (empty) empty.hidden = visible !== 0;
      if (status) status.textContent = `Mostrando ${visible} de ${cards.length} proyectos`;
    };

    const select = (team: string) => {
      if ('startViewTransition' in document && !reduceMotion) {
        (document as Document & { startViewTransition: (cb: () => void) => unknown }).startViewTransition(() =>
          apply(team)
        );
      } else {
        apply(team);
      }
      const url = new URL(location.href);
      if (team === 'all') url.searchParams.delete('equipo');
      else url.searchParams.set('equipo', team);
      url.hash = '';
      history.replaceState(null, '', url);
    };

    for (const button of buttons) {
      button.addEventListener('click', () => select(button.dataset.filter ?? 'all'));
    }

    const requested = new URL(location.href).searchParams.get('equipo') ?? location.hash.slice(1);
    apply(valid.has(requested) ? requested : 'all');
  }
</script>

<style>
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: 2.25rem;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .filter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-family: var(--font-body);
    font-size: 0.88rem;
    font-weight: 600;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-up-ink) 18%, transparent);
    background: transparent;
    color: var(--color-up-ink);
    cursor: pointer;
    transition: background var(--duration-fast) ease, color var(--duration-fast) ease,
      border-color var(--duration-fast) ease, transform var(--duration-fast) var(--ease-editorial);
  }
  .filter:hover {
    border-color: var(--color-up-ink);
    transform: translateY(-1px);
  }
  .filter .count {
    font-size: 0.72rem;
    padding: 0.05rem 0.45rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-up-ink) 10%, transparent);
  }
  .filter.is-active {
    background: var(--accent, var(--color-up-ink));
    color: var(--on-accent, var(--color-up-paper));
    border-color: var(--accent, var(--color-up-ink));
  }
  .filter.is-active .count {
    background: color-mix(in srgb, var(--on-accent, var(--color-up-paper)) 22%, transparent);
  }

  .status {
    font-size: 0.85rem;
    color: color-mix(in srgb, var(--color-up-ink) 60%, transparent);
  }

  .empty {
    padding: 3rem 0;
    text-align: center;
    color: color-mix(in srgb, var(--color-up-ink) 55%, transparent);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17.5rem, 1fr));
    gap: 1.5rem;
  }
  .cell[hidden] {
    display: none;
  }
</style>
