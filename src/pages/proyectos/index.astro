---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectGallery from '@/components/ProjectGallery.astro';
import CTASection from '@/components/CTASection.astro';
import { projects } from '@/data/projects';
---

<BaseLayout
  title="Proyectos"
  description="Vitrina de proyectos desarrollados por los equipos de Nexus Labs: Computer Science, Play, Mechanics e IISE."
>
  <section class="container-editorial header">
    <p class="kicker rise" style="--d:0">Nexus Labs · Proyectos</p>
    <h1 class="rise" style="--d:1">Lo que construyen los equipos</h1>
    <p class="lead rise" style="--d:2">
      {projects.length} proyectos documentados, de prototipos de robótica a
      consultoría de procesos. Filtra por equipo y toca cualquier proyecto
      para ver el reto, el enfoque y el resultado.
    </p>
  </section>

  <section class="container-editorial section">
    <ProjectGallery projects={projects} />
  </section>

  <CTASection />
</BaseLayout>

<style>
  .header {
    padding-block: clamp(4rem, 6vw, 6.5rem) clamp(2rem, 3vw, 3rem);
    max-width: 50rem;
  }
  h1 {
    margin-top: 0.75rem;
    font-size: var(--text-display-lg);
    text-transform: uppercase;
    letter-spacing: 0.01em;
    line-height: 0.98;
  }
  .lead {
    margin-top: 1.5rem;
    color: color-mix(in srgb, var(--color-up-ink) 75%, transparent);
  }
  .section {
    padding-block: clamp(1rem, 2vw, 2rem) var(--spacing-section-y);
  }
</style>
