---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Manifesto from '@/components/Manifesto.astro';
import TeamStack from '@/components/TeamStack.astro';
import FeaturedRail from '@/components/FeaturedRail.astro';
import StatRow from '@/components/StatRow.astro';
import Button from '@/components/Button.astro';
import CTASection from '@/components/CTASection.astro';
import { getFeatured } from '@/data/projects';
import { teams } from '@/data/teams';

const activeTeams = teams.flatMap((team) => team.subteams).filter((subteam) => subteam.status === 'activo').length;

const benefits = ['Compite', 'Crea productos', 'Vincúlate con empleadores', 'Arma comunidad', 'Gana experiencia real'];

const aggregateStats = [
  { label: 'Áreas', value: String(teams.length) },
  { label: 'Equipos activos', value: String(activeTeams) },
  { label: 'De estudiantes participan', value: 'Cientos' },
];

const manifesto = `Nexus Labs reúne a los grupos estudiantiles de la Facultad de Ingeniería de la Universidad Panamericana: ${teams.length} áreas y ${activeTeams} equipos, abiertos a estudiantes de todas las carreras.`;
---

<BaseLayout
  title="Nexus Labs"
  description="Nexus Labs reúne a los grupos estudiantiles de la Facultad de Ingeniería de la Universidad Panamericana: Play, Computer Science, Mechanics e IISE."
>
  <Hero />

  <section class="container-editorial section about">
    <Manifesto kicker="Quiénes somos" text={manifesto} />

    <ul class="benefits">
      {benefits.map((benefit, i) => (
        <li data-reveal style={`--d:${i}`}>
          <span class="benefit__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          {benefit}
        </li>
      ))}
    </ul>
  </section>

  <section class="container-editorial section" id="equipos">
    <div class="section-head" data-reveal>
      <div>
        <p class="kicker">Equipos</p>
        <h2>Elige tu área</h2>
      </div>
      <Button href="/equipos" variant="ghost">Ver las 4 áreas</Button>
    </div>
    <TeamStack />
  </section>

  <section class="band">
    <div class="container-editorial">
      <p class="kicker" data-reveal>Nexus Labs</p>
      <div class="band__stats" data-reveal style="--d:1">
        <StatRow stats={aggregateStats} dark />
      </div>
    </div>
  </section>

  <section class="container-editorial section" id="proyectos">
    <div class="section-head" data-reveal>
      <div>
        <p class="kicker">Portafolio</p>
        <h2>Proyectos recientes</h2>
      </div>
      <Button href="/proyectos" variant="ghost">Ver todos los proyectos</Button>
    </div>
    <div data-reveal style="--d:1">
      <FeaturedRail projects={getFeatured(6)} label="Proyectos recientes" />
    </div>
  </section>

  <CTASection />
</BaseLayout>

<style>
  .section {
    padding-block: var(--spacing-section-y);
  }

  .benefits {
    margin-top: 3.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 1rem;
    list-style: none;
  }
  .benefits li {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    min-height: 8rem;
    padding: 1.25rem 1.4rem;
    border-radius: 1.1rem;
    background: color-mix(in srgb, var(--color-up-gold) 10%, var(--color-up-paper));
    border: 1px solid color-mix(in srgb, var(--color-up-gold) 30%, transparent);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.2rem;
    line-height: 1.2;
    transition: transform var(--duration-base) var(--ease-editorial),
      box-shadow var(--duration-base) var(--ease-editorial);
  }
  .benefits li:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 40px -28px rgb(0 0 0 / 0.3);
  }
  .benefit__n {
    font-size: 0.85rem;
    color: var(--color-up-gold-ink);
  }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }
  .section-head h2 {
    margin-top: 0.5rem;
    font-size: var(--text-display-lg);
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  .band {
    margin-block: 1rem;
    padding-block: clamp(3.5rem, 6vw, 6rem);
    background: var(--color-up-blue);
    color: var(--color-up-paper);
  }
  .band .kicker {
    color: color-mix(in srgb, var(--color-up-paper) 78%, transparent);
  }
  .band__stats {
    margin-top: 2rem;
  }

</style>
