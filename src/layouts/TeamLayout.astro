---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import CoverArt from '@/components/CoverArt.astro';
import StatRow from '@/components/StatRow.astro';
import ProjectGallery from '@/components/ProjectGallery.astro';
import CTASection from '@/components/CTASection.astro';
import { getTeam, teams, type TeamId } from '@/data/teams';
import { getProjectsByTeam } from '@/data/projects';

interface Props {
  slug: TeamId;
}
const { slug } = Astro.props;
const team = getTeam(slug);
if (!team) throw new Error(`Equipo no encontrado: ${slug}`);
const teamProjects = getProjectsByTeam(team.id);
const nextTeam = teams[(teams.findIndex((t) => t.id === team.id) + 1) % teams.length];
const activeSubteams = team.subteams.filter((s) => s.status === 'activo');
const inactiveSubteams = team.subteams.filter((s) => s.status === 'inactivo');
---

<BaseLayout title={team.fullName} description={team.summary}>
<div class="team-page" data-tone={team.id}>
  <section class="team-hero area-hero">
    <div class="tahali" aria-hidden="true"></div>
    <div class="container-editorial hero__grid">
      <div class="inner">
        <a href="/equipos" class="back rise" style="--d:0">← Todos los equipos</a>
        <p class="kicker rise" style="--d:1">Nexus Labs · Equipo</p>
        <h1 class="rise" style="--d:2">{team.shortName}</h1>
        <p class="tagline rise" style="--d:3">{team.tagline}</p>
        <p class="summary rise" style="--d:4">{team.summary}</p>
        <ul class="keywords rise" style="--d:4">
          {team.keywords.map((word) => <li>{word}</li>)}
        </ul>
        <div class="actions rise" style="--d:5">
          {team.subteams.length > 0 ? (
            <Button href="#subequipos" variant="secondary">Ver los equipos</Button>
          ) : (
            <Button href="#proyectos" variant="secondary">Ver proyectos del equipo</Button>
          )}
          <Button href="/#unete" variant="ghost">Quiero unirme</Button>
        </div>
      </div>
      <div class="hero__art rise" style="--d:3">
        <CoverArt team={team.id} seed={`hero-${team.id}`} />
      </div>
    </div>
  </section>

  <section class="container-editorial section">
    <div class="two-col">
      <div class="prose" data-reveal>
        <p class="kicker">Sobre el equipo</p>
        {team.description.map((paragraph) => <p>{paragraph}</p>)}
        {team.joinNote && <p class="join-note">{team.joinNote}</p>}
      </div>
      <aside class="stats-card" data-reveal style="--d:1">
        <StatRow stats={team.stats} />
        {team.events.length > 0 && (
          <div class="events">
            <p class="kicker">Concursos y eventos</p>
            <ul>
              {team.events.map((event) => <li>{event}</li>)}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </section>

  {team.subteams.length > 0 && (
    <section id="subequipos" class="container-editorial section subteams-section">
      <div data-reveal>
        <p class="kicker">Dentro de {team.shortName}</p>
        <h2>Equipos</h2>
      </div>

      {activeSubteams.length > 0 && (
        <div class="subteam-grid">
          {activeSubteams.map((subteam, i) => (
            <div data-reveal style={`--d:${i}`}>
              <a class="subteam-card" href={`/equipos/${team.slug}/${subteam.slug}`} data-glow>
                <span class="subteam-card__status">Activo</span>
                <h3>{subteam.name}</h3>
                <p>{subteam.briefDescription}</p>
                <span class="subteam-card__go" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
                    <path d="M4 10h12M12 5l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </a>
            </div>
          ))}
        </div>
      )}

      {inactiveSubteams.length > 0 && (
        <div class="subteam-history" data-reveal style={`--d:${activeSubteams.length}`}>
          <p class="kicker">Equipos anteriores</p>
          <div class="subteam-grid subteam-grid--compact">
            {inactiveSubteams.map((subteam) => (
              <a class="subteam-card subteam-card--inactive" href={`/equipos/${team.slug}/${subteam.slug}`}>
                <span class="subteam-card__status subteam-card__status--inactive">Ya no activo</span>
                <h3>{subteam.name}</h3>
                <p>{subteam.briefDescription}</p>
              </a>
            ))}
          </div>
        </div>
      )}
    </section>
  )}

  <section id="proyectos" class="container-editorial section">
    <div class="head" data-reveal>
      <div>
        <p class="kicker">Portafolio</p>
        <h2>Proyectos de {team.shortName}</h2>
      </div>
      <Button href={`/proyectos?equipo=${team.slug}`} variant="ghost">Abrir en el catálogo</Button>
    </div>
    <div class="gallery-wrap">
      <ProjectGallery projects={teamProjects} filterable={false} />
    </div>
  </section>

  <section class="container-editorial next" data-reveal>
    <a class="next__link" href={`/equipos/${nextTeam.slug}`} data-tone={nextTeam.id}>
      <span class="kicker">Siguiente equipo</span>
      <span class="next__name">{nextTeam.shortName} →</span>
      <span class="next__tag">{nextTeam.tagline}</span>
    </a>
  </section>

  <CTASection />
</div>
</BaseLayout>

<style>
  .team-hero {
    padding-block: clamp(2.5rem, 5vw, 5rem) clamp(3rem, 6vw, 5.5rem);
  }
  .team-hero .tahali {
    position: absolute;
    inset: -20% -10%;
    background: linear-gradient(100deg, transparent 0 46%, color-mix(in srgb, var(--on-accent) 5%, transparent) 46% 52%, transparent 52% 100%);
  }
  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(1.75rem, 4vw, 4.5rem);
    align-items: center;
  }
  .hero__art {
    aspect-ratio: 400 / 260;
    border-radius: 1.5rem;
    overflow: hidden;
    box-shadow:
      0 40px 90px -30px color-mix(in srgb, var(--accent) 75%, transparent),
      0 0 0 1px color-mix(in srgb, var(--color-up-paper) 16%, transparent);
  }
  .back {
    display: inline-block;
    margin-bottom: 1.75rem;
    padding-block: 0.4rem;
    font-size: 0.88rem;
    color: color-mix(in srgb, var(--on-accent) 82%, transparent);
    text-decoration: none;
  }
  .back:hover { text-decoration: underline; }
  .team-hero .kicker { color: var(--accent-bright); }
  .team-hero h1 {
    margin-top: 0.75rem;
    font-size: clamp(2.2rem, 1.1rem + 4.6vw, 5.4rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
    overflow-wrap: break-word;
    background: linear-gradient(
      180deg,
      var(--color-up-paper) 35%,
      color-mix(in srgb, var(--accent-bright) 72%, var(--color-up-paper)) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .tagline {
    margin-top: 1rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.15rem;
    color: color-mix(in srgb, var(--on-accent) 94%, transparent);
  }
  .summary {
    margin-top: 1.1rem;
    max-width: 44ch;
    color: color-mix(in srgb, var(--on-accent) 86%, transparent);
  }
  .keywords {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
  }
  .keywords li {
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    background: color-mix(in srgb, var(--on-accent) 16%, transparent);
    color: var(--on-accent);
  }
  .actions {
    margin-top: 2.1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .team-hero :global(.btn--ghost) {
    color: var(--on-accent);
    border-color: color-mix(in srgb, var(--on-accent) 45%, transparent);
  }
  .team-hero :global(.btn--ghost:hover) {
    background: color-mix(in srgb, var(--on-accent) 12%, transparent);
    border-color: var(--on-accent);
  }

  .section {
    padding-block: var(--spacing-section-y);
  }
  .section h2 {
    margin-top: 0.5rem;
    font-size: var(--text-display-md);
    max-width: 30ch;
  }
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  .prose p {
    margin-top: 1rem;
    color: color-mix(in srgb, var(--color-up-ink) 78%, transparent);
    max-width: 60ch;
  }
  .prose p.kicker {
    margin-top: 0;
    color: var(--accent-text);
  }
  .prose .join-note {
    margin-top: 1.5rem;
    font-style: italic;
  }
  .stats-card {
    padding: 1.75rem;
    border-radius: 1.25rem;
    background: color-mix(in srgb, var(--accent) 8%, var(--color-up-paper));
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
    position: sticky;
    top: 6.5rem;
  }

  .subteams-section {
    padding-top: 0;
  }

  .subteam-grid {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.25rem;
  }
  .subteam-grid--compact {
    margin-top: 1.25rem;
  }

  .subteam-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
    padding: 1.5rem;
    border-radius: 1rem;
    background: var(--color-up-paper);
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
    text-decoration: none;
    color: var(--color-up-ink);
    transition: transform var(--duration-base) var(--ease-editorial),
      box-shadow var(--duration-base) var(--ease-editorial);
  }
  .subteam-card:hover,
  .subteam-card:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 24px 44px -28px rgb(0 0 0 / 0.3);
  }
  .subteam-grid > div:nth-child(even) .subteam-card {
    background: color-mix(in srgb, var(--accent) 7%, var(--color-up-paper));
  }
  .subteam-card h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
  }
  .subteam-card p {
    font-size: 0.9rem;
    color: color-mix(in srgb, var(--color-up-ink) 70%, transparent);
  }
  .subteam-card__status {
    align-self: flex-start;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
  }
  .subteam-card__go {
    margin-top: auto;
    align-self: flex-end;
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    transition: transform var(--duration-fast) var(--ease-editorial);
  }
  .subteam-card:hover .subteam-card__go {
    transform: translateX(3px);
  }

  .subteam-card--inactive {
    background: color-mix(in srgb, var(--color-up-ink) 4%, var(--color-up-paper));
    border-style: dashed;
    opacity: 0.88;
  }
  .subteam-card__status--inactive {
    background: color-mix(in srgb, var(--color-up-ink) 14%, transparent);
    color: var(--color-up-ink);
  }

  .subteam-history {
    margin-top: 3rem;
  }

  .events {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
  }
  .events .kicker {
    color: var(--accent-text);
  }
  .events ul {
    margin-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
  }
  .events li {
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 500;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    color: var(--color-up-ink);
  }

  .gallery-wrap {
    margin-top: 2.5rem;
  }

  .next {
    padding-bottom: 1rem;
  }
  .next__link {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border-radius: 1.5rem;
    background: color-mix(in srgb, var(--accent) 10%, var(--color-up-paper));
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    color: var(--color-up-ink);
    text-decoration: none;
    transition: transform var(--duration-base) var(--ease-editorial),
      background var(--duration-base) ease;
  }
  .next__link:hover {
    transform: translateY(-4px);
    background: color-mix(in srgb, var(--accent) 16%, var(--color-up-paper));
  }
  .next__link .kicker {
    color: var(--accent-text);
  }
  .next__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-display-lg);
    line-height: 1;
  }
  .next__tag {
    color: color-mix(in srgb, var(--color-up-ink) 70%, transparent);
  }

  @media (max-width: 860px) {
    .hero__grid,
    .two-col {
      grid-template-columns: 1fr;
    }
    .stats-card {
      position: static;
    }
  }
</style>
