---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import CoverArt from '@/components/CoverArt.astro';
import StatRow from '@/components/StatRow.astro';
import ProjectGallery from '@/components/ProjectGallery.astro';
import CTASection from '@/components/CTASection.astro';
import { getTeam, teams, type TeamId } from '@/data/teams';
import { getProjectsByTeam } from '@/data/projects';

interface Props {
  slug: TeamId;
}
const { slug } = Astro.props;
const team = getTeam(slug);
if (!team) throw new Error(`Equipo no encontrado: ${slug}`);
const teamProjects = getProjectsByTeam(team.id);
const nextTeam = teams[(teams.findIndex((t) => t.id === team.id) + 1) % teams.length];
---

<BaseLayout title={team.fullName} description={team.summary}>
<div class="team-page" data-tone={team.color}>
  <section class="team-hero">
    <div class="tahali" aria-hidden="true"></div>
    <div class="container-editorial hero__grid">
      <div class="inner">
        <a href="/equipos" class="back rise" style="--d:0">← Todos los equipos</a>
        <p class="kicker rise" style="--d:1">Nexus Labs · Equipo</p>
        <h1 class="rise" style="--d:2">{team.shortName}</h1>
        <p class="tagline rise" style="--d:3">{team.tagline}</p>
        <p class="summary rise" style="--d:4">{team.summary}</p>
        <div class="actions rise" style="--d:5">
          <Button href="#proyectos" variant="secondary">Ver proyectos del equipo</Button>
          <Button href="/#unete" variant="ghost">Quiero unirme</Button>
        </div>
      </div>
      <div class="hero__art rise" style="--d:3">
        <CoverArt team={team.id} seed={`hero-${team.id}`} />
      </div>
    </div>
  </section>

  <section class="container-editorial section">
    <div class="two-col">
      <div class="prose" data-reveal>
        <p class="kicker">Sobre el equipo</p>
        {team.description.map((paragraph) => <p>{paragraph}</p>)}
        <p class="cadence">
          <strong>Sesiones:</strong> {team.cadence}
        </p>
        <p class="join-note">{team.joinNote}</p>
      </div>
      <aside class="stats-card" data-reveal style="--d:1">
        <StatRow stats={team.stats} />
      </aside>
    </div>
  </section>

  <section class="container-editorial section">
    <div data-reveal>
      <p class="kicker">En qué trabaja {team.shortName}</p>
      <h2>Áreas de enfoque</h2>
    </div>
    <div class="focus-grid">
      {team.focusAreas.map((area, i) => (
        <div data-reveal style={`--d:${i}`}>
          <article class="focus-card">
            <span class="focus-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{area.title}</h3>
            <p>{area.detail}</p>
          </article>
        </div>
      ))}
    </div>
  </section>

  <section id="proyectos" class="container-editorial section">
    <div class="head" data-reveal>
      <div>
        <p class="kicker">Portafolio</p>
        <h2>Proyectos de {team.shortName}</h2>
      </div>
      <Button href={`/proyectos?equipo=${team.slug}`} variant="ghost">Abrir en el catálogo</Button>
    </div>
    <div class="gallery-wrap">
      <ProjectGallery projects={teamProjects} filterable={false} />
    </div>
  </section>

  <section class="container-editorial next" data-reveal>
    <a class="next__link" href={`/equipos/${nextTeam.slug}`} data-tone={nextTeam.color}>
      <span class="kicker">Siguiente equipo</span>
      <span class="next__name">{nextTeam.shortName} →</span>
      <span class="next__tag">{nextTeam.tagline}</span>
    </a>
  </section>

  <CTASection />
</div>
</BaseLayout>

<style>
  .team-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 5vw, 5rem) clamp(3rem, 6vw, 5.5rem);
    background: color-mix(in srgb, var(--accent) 92%, black 8%);
    color: var(--on-accent);
  }
  .team-hero .tahali {
    position: absolute;
    inset: -20% -10%;
    background: linear-gradient(100deg, transparent 0 46%, color-mix(in srgb, var(--on-accent) 12%, transparent) 46% 52%, transparent 52% 100%);
  }
  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(1.75rem, 4vw, 4.5rem);
    align-items: center;
  }
  .hero__art {
    aspect-ratio: 400 / 260;
    border-radius: 1.5rem;
    overflow: hidden;
    box-shadow: 0 40px 70px -35px rgb(0 0 0 / 0.55);
    outline: 1px solid color-mix(in srgb, var(--on-accent) 22%, transparent);
    outline-offset: -1px;
  }
  .back {
    display: inline-block;
    margin-bottom: 1.75rem;
    padding-block: 0.4rem;
    font-size: 0.88rem;
    color: color-mix(in srgb, var(--on-accent) 82%, transparent);
    text-decoration: none;
  }
  .back:hover { text-decoration: underline; }
  .team-hero .kicker { color: color-mix(in srgb, var(--on-accent) 85%, transparent); }
  .team-hero h1 {
    margin-top: 0.75rem;
    font-size: clamp(2.6rem, 1.4rem + 4.6vw, 5.6rem);
    text-transform: uppercase;
    letter-spacing: 0.01em;
    line-height: 0.95;
  }
  .tagline {
    margin-top: 1rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.15rem;
    color: color-mix(in srgb, var(--on-accent) 94%, transparent);
  }
  .summary {
    margin-top: 1.1rem;
    max-width: 44ch;
    color: color-mix(in srgb, var(--on-accent) 86%, transparent);
  }
  .actions {
    margin-top: 2.1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .team-hero :global(.btn--ghost) {
    color: var(--on-accent);
    border-color: color-mix(in srgb, var(--on-accent) 45%, transparent);
  }
  .team-hero :global(.btn--ghost:hover) {
    background: color-mix(in srgb, var(--on-accent) 12%, transparent);
    border-color: var(--on-accent);
  }
  .team-page[data-tone='gold'] .team-hero :global(.btn--secondary) {
    background: var(--color-up-ink);
    color: var(--color-up-paper);
  }
  .team-page[data-tone='gold'] .team-hero :global(.btn--secondary:hover) {
    background: var(--color-up-charcoal);
  }

  .section {
    padding-block: var(--spacing-section-y);
  }
  .section h2 {
    margin-top: 0.5rem;
    font-size: var(--text-display-md);
    text-transform: uppercase;
    letter-spacing: 0.01em;
    max-width: 30ch;
  }
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  .prose p {
    margin-top: 1rem;
    color: color-mix(in srgb, var(--color-up-ink) 78%, transparent);
    max-width: 60ch;
  }
  .prose p.kicker {
    margin-top: 0;
    color: var(--accent-text);
  }
  .prose .cadence {
    margin-top: 1.5rem;
    color: var(--color-up-ink);
  }
  .join-note {
    font-style: italic;
  }
  .stats-card {
    padding: 1.75rem;
    border-radius: 1.25rem;
    background: color-mix(in srgb, var(--accent) 8%, var(--color-up-paper));
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
    position: sticky;
    top: 6.5rem;
  }

  .focus-grid {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.25rem;
  }
  .focus-card {
    position: relative;
    height: 100%;
    padding: 1.75rem;
    border-radius: 1rem;
    background: var(--color-up-paper);
    border: 1px solid color-mix(in srgb, var(--color-up-ink) 10%, transparent);
    border-top: 3px solid var(--accent);
    transition: transform var(--duration-base) var(--ease-editorial),
      box-shadow var(--duration-base) var(--ease-editorial);
  }
  .focus-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 40px -28px rgb(0 0 0 / 0.3);
  }
  .focus-n {
    display: block;
    margin-bottom: 0.9rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--accent-text);
  }
  .focus-card h3 {
    font-size: 1.05rem;
    font-family: var(--font-display);
  }
  .focus-card p {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    color: color-mix(in srgb, var(--color-up-ink) 68%, transparent);
  }

  .gallery-wrap {
    margin-top: 2.5rem;
  }

  .next {
    padding-bottom: 1rem;
  }
  .next__link {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border-radius: 1.5rem;
    background: color-mix(in srgb, var(--accent) 10%, var(--color-up-paper));
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    color: var(--color-up-ink);
    text-decoration: none;
    transition: transform var(--duration-base) var(--ease-editorial),
      background var(--duration-base) ease;
  }
  .next__link:hover {
    transform: translateY(-4px);
    background: color-mix(in srgb, var(--accent) 16%, var(--color-up-paper));
  }
  .next__link .kicker {
    color: var(--accent-text);
  }
  .next__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-display-lg);
    text-transform: uppercase;
    line-height: 1;
  }
  .next__tag {
    color: color-mix(in srgb, var(--color-up-ink) 70%, transparent);
  }

  @media (max-width: 860px) {
    .hero__grid,
    .two-col {
      grid-template-columns: 1fr;
    }
    .stats-card {
      position: static;
    }
  }
</style>
