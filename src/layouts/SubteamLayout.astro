---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import CoverArt from '@/components/CoverArt.astro';
import StatRow from '@/components/StatRow.astro';
import ProjectGallery from '@/components/ProjectGallery.astro';
import CTASection from '@/components/CTASection.astro';
import type { Team, Subteam } from '@/data/teams';
import { getProjectsBySubteam } from '@/data/projects';

interface Props {
  team: Team;
  subteam: Subteam;
}
const { team, subteam } = Astro.props;
const subteamProjects = getProjectsBySubteam(team.id, subteam.slug);
const isActive = subteam.status === 'activo';
const facts = [subteam.objective, subteam.mission, subteam.vision].filter(Boolean);
const intro = subteam.description ?? subteam.briefDescription;
const hasDetails =
  facts.length > 0 ||
  Boolean(
    subteam.activities?.length || subteam.milestones?.length || subteam.stats?.length || subteam.links?.length
  );
---

<BaseLayout
  title={`${subteam.name} · ${team.shortName}`}
  description={subteam.briefDescription}
>
  <div class="subteam-page" data-tone={subteam.tone ?? team.id}>
    <section class="hero area-hero">
      <div class="tahali" aria-hidden="true"></div>
      <div class="container-editorial hero__grid">
        <div class="inner">
          <a href={`/equipos/${team.slug}`} class="back rise" style="--d:0">← {team.shortName}</a>
          <p class="kicker rise" style="--d:1">
            {team.shortName}
            <span class:list={['badge', { 'badge--inactive': !isActive }]}>
              {isActive ? 'Activo' : 'Ya no está activo'}
            </span>
          </p>
          <h1 class="rise" style="--d:2">{subteam.name}</h1>
          <p class="summary rise" style="--d:3">{intro}</p>
          {subteam.note && <p class="note rise" style="--d:4">{subteam.note}</p>}
          {isActive && (
            <div class="actions rise" style="--d:5">
              <Button href="/#unete" variant="secondary">Quiero unirme</Button>
              {subteamProjects.length > 0 && (
                <Button href="#proyectos" variant="ghost">Ver proyectos</Button>
              )}
            </div>
          )}
        </div>
        <div
          class:list={['hero__art', 'rise', { 'hero__art--logo': subteam.logo, 'hero__art--dark': subteam.logo?.dark }]}
          style="--d:3"
        >
          {subteam.logo ? (
            <>
              <img class="logo-main" src={subteam.logo.src} alt={subteam.logo.alt} width="540" height="540" />
              {subteam.logo.wordmark && (
                <img class="logo-word" src={subteam.logo.wordmark} alt="" width="1130" height="210" />
              )}
            </>
          ) : (
            <CoverArt team={team.id} seed={`subteam-${team.id}-${subteam.slug}`} />
          )}
        </div>
      </div>
    </section>

    {hasDetails && (
      <section class="container-editorial section">
        {subteam.stats && subteam.stats.length > 0 && (
          <div class="stats" data-reveal>
            <StatRow stats={subteam.stats} />
          </div>
        )}

        <div class="facts">
          {subteam.objective && (
            <article class="fact" data-reveal>
              <p class="kicker">Objetivo</p>
              <p>{subteam.objective}</p>
            </article>
          )}
          {subteam.mission && (
            <article class="fact" data-reveal style="--d:1">
              <p class="kicker">Misión</p>
              <p>{subteam.mission}</p>
            </article>
          )}
          {subteam.vision && (
            <article class="fact" data-reveal style="--d:2">
              <p class="kicker">Visión</p>
              <p>{subteam.vision}</p>
            </article>
          )}
        </div>

        {subteam.activities && subteam.activities.length > 0 && (
          <div class="activities" data-reveal style="--d:3">
            <p class="kicker">Principales actividades</p>
            <ul>
              {subteam.activities.map((activity) => <li>{activity}</li>)}
            </ul>
          </div>
        )}

        {subteam.currentProjects && (
          <div class="milestones" data-reveal style="--d:3">
            <p class="kicker">{subteam.currentProjects.label}</p>
            <ul>
              {subteam.currentProjects.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        )}

        {subteam.milestones && subteam.milestones.length > 0 && (
          <div class="milestones" data-reveal style="--d:3">
            <p class="kicker">{subteam.milestonesLabel ?? 'Hitos'}</p>
            <ul>
              {subteam.milestones.map((milestone) => <li>{milestone}</li>)}
            </ul>
          </div>
        )}

        {subteam.links && subteam.links.length > 0 && (
          <div class="links" data-reveal style="--d:4">
            <p class="kicker">Enlaces</p>
            <ul>
              {subteam.links.map((link) => (
                <li>
                  <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>
    )}

    {subteam.gallery && subteam.gallery.length > 0 && (
      <section class="gallery-band">
        <div class="container-editorial">
          <p class="kicker" data-reveal>En sesión</p>
          <div class="photos">
            {subteam.gallery.map((photo, i) => (
              <figure data-reveal style={`--d:${i}`}>
                <img src={photo.src} alt={photo.alt} width="1280" height="960" loading="lazy" decoding="async" />
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    {subteamProjects.length > 0 && (
      <section id="proyectos" class="container-editorial section">
        <div data-reveal>
          <p class="kicker">Portafolio</p>
          <h2>Proyectos de {subteam.name}</h2>
        </div>
        <div class="gallery-wrap">
          <ProjectGallery projects={subteamProjects} filterable={false} />
        </div>
      </section>
    )}

    <CTASection />
  </div>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(2.5rem, 5vw, 5rem) clamp(3rem, 6vw, 5.5rem);
  }
  .hero .tahali {
    position: absolute;
    inset: -20% -10%;
    background: linear-gradient(100deg, transparent 0 46%, color-mix(in srgb, var(--on-accent) 5%, transparent) 46% 52%, transparent 52% 100%);
  }
  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(1.75rem, 4vw, 4.5rem);
    align-items: center;
  }
  .hero__art {
    aspect-ratio: 400 / 260;
    border-radius: 1.5rem;
    overflow: hidden;
    box-shadow:
      0 40px 90px -30px color-mix(in srgb, var(--accent) 75%, transparent),
      0 0 0 1px color-mix(in srgb, var(--color-up-paper) 16%, transparent);
  }
  .back {
    display: inline-block;
    margin-bottom: 1.75rem;
    padding-block: 0.4rem;
    font-size: 0.88rem;
    color: color-mix(in srgb, var(--on-accent) 82%, transparent);
    text-decoration: none;
  }
  .back:hover { text-decoration: underline; }
  .hero .kicker {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--accent-bright);
  }
  .badge {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--on-accent) 18%, transparent);
  }
  .badge--inactive {
    background: color-mix(in srgb, var(--on-accent) 10%, transparent);
    opacity: 0.85;
  }
  h1 {
    margin-top: 0.75rem;
    font-size: clamp(2.3rem, 1.5rem + 3.6vw, 4.6rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
    background: linear-gradient(180deg, var(--color-up-paper) 35%, color-mix(in srgb, var(--accent-bright) 72%, var(--color-up-paper)) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .summary {
    margin-top: 1.1rem;
    max-width: 46ch;
    font-size: 1.05rem;
    color: color-mix(in srgb, var(--on-accent) 90%, transparent);
  }
  .note {
    margin-top: 0.9rem;
    max-width: 46ch;
    font-size: 0.92rem;
    font-style: italic;
    color: color-mix(in srgb, var(--on-accent) 78%, transparent);
  }
  .actions {
    margin-top: 2.1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .hero :global(.btn--ghost) {
    color: var(--on-accent);
    border-color: color-mix(in srgb, var(--on-accent) 45%, transparent);
  }

  .section {
    padding-block: var(--spacing-section-y);
  }
  .section h2 {
    margin-top: 0.5rem;
    font-size: var(--text-display-md);
    letter-spacing: 0.01em;
  }
  .section .kicker {
    color: var(--accent-text);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.5rem;
  }
  .fact {
    padding-top: 1rem;
    border-top: 2px solid var(--accent);
  }
  .fact p:last-child {
    margin-top: 0.75rem;
    color: color-mix(in srgb, var(--color-up-ink) 78%, transparent);
    line-height: 1.5;
  }

  .stats {
    margin-bottom: 3rem;
  }
  .hero__art--logo {
    position: relative;
    background: #fff;
  }
  .hero__art--logo img {
    position: absolute;
    inset: clamp(0.75rem, 2.5vw, 1.5rem);
    width: calc(100% - 2 * clamp(0.75rem, 2.5vw, 1.5rem));
    height: calc(100% - 2 * clamp(0.75rem, 2.5vw, 1.5rem));
    object-fit: contain;
  }
  .hero__art--dark {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 3vw, 1.5rem);
    padding: clamp(1rem, 4vw, 2rem);
    background:
      radial-gradient(60% 70% at 50% 40%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 70%),
      var(--pwn-ink);
  }
  .hero__art--dark img {
    position: static;
    inset: auto;
  }
  .hero__art--dark .logo-main {
    width: auto;
    height: 52%;
  }
  .hero__art--dark .logo-word {
    width: min(78%, 22rem);
    height: auto;
  }

  .gallery-band {
    padding-block: var(--spacing-section-y);
    background: var(--pwn-ink, var(--color-up-ink));
    color: #ededed;
  }
  .gallery-band .kicker {
    color: var(--accent-bright);
  }
  .photos {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }
  .photos figure {
    overflow: hidden;
    border-radius: 1.1rem;
    outline: 1px solid color-mix(in srgb, #ededed 14%, transparent);
  }
  .photos img {
    display: block;
    width: 100%;
    height: auto;
  }

  .activities,
  .milestones,
  .links {
    margin-top: 2.5rem;
  }
  .activities ul,
  .milestones ul,
  .links ul {
    margin-top: 0.75rem;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .activities li,
  .milestones li {
    color: color-mix(in srgb, var(--color-up-ink) 78%, transparent);
  }
  .links a {
    color: var(--accent-text);
    font-weight: 600;
    text-decoration: none;
  }
  .links a:hover {
    text-decoration: underline;
    text-decoration-color: var(--pwn-amber, currentColor);
    text-underline-offset: 0.25em;
  }

  .gallery-wrap {
    margin-top: 2.5rem;
  }

  @media (max-width: 860px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
